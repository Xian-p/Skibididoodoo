{
  "model": "meta-llama/llama-3.1-8b-instruct:free",
  "fallbackModels": [],
  "toolProtocol": "native",
  "maxIterations": 25,
  "commandTimeoutSec": 120,
  "permissionMode": "ask",
  "dangerousMode": "ask",
  "contextLimitTokens": 60000,
  "autoCompact": true,
  "excludedDirs": [
    "node_modules",
    ".git",
    "dist",
    "build",
    ".next",
    ".cache",
    ".opencode",
    "coverage",
    "target",
    "out",
    ".venv",
    "venv",
    "__pycache__",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".svelte-kit",
    ".turbo",
    ".vite"
  ],
  "allowCommands": [
    "git status",
    "git diff",
    "git log",
    "ls",
    "cat"
  ],
  "denyCommands": []
}
